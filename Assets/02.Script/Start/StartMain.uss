.StartLabel {
    bottom: 234px;
    transition-duration: 1s;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.StartLabel-Blink {
    color: rgba(255, 255, 255, 0.3);
    transition-duration: 1s;
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.3);
}
