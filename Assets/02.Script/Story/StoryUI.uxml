<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <engine:VisualElement name="StoryUI" style="flex-grow: 1; width: 100%; height: 30%; position: absolute; bottom: 0; background-color: rgb(176, 133, 69); display: flex; background-image: none; padding-top: 20px; padding-right: 20px; padding-bottom: 20px; padding-left: 20px; align-items: center; justify-content: center; flex-direction: row; -unity-font-definition: url(&quot;project://database/Assets/05.Font/Maplestory%20Bold.ttf?fileID=12800000&amp;guid=cb734c07d35dbf549a5a6fce9ebf42b1&amp;type=3#Maplestory Bold&quot;); font-size: 39px;">
        <engine:VisualElement name="Frame" picking-mode="Ignore" style="flex-grow: 1; width: 100%; height: 100%; position: absolute; background-image: url(&quot;project://database/Assets/Asset/Honeti/PixelArtGUI3/Textures/Panels/WindowStroke2.png?fileID=21300000&amp;guid=f1ad16e66091e1344a57f36d05134015&amp;type=3#WindowStroke2&quot;); bottom: 9px;" />
        <engine:VisualElement name="Left" style="flex-grow: 0.1; height: 100%; flex-shrink: 0; align-items: center; padding-top: 38px;">
            <engine:Button name="Image" style="height: 250px; width: 250px; background-color: rgba(188, 188, 188, 0); background-image: url(&quot;project://database/Assets/07.Texture/RenderTexture/PlayerCompanionRenderTexture.renderTexture?fileID=8400000&amp;guid=702b6e7164ab6d7439554990f2b5d509&amp;type=2#PlayerCompanionRenderTexture&quot;);" />
            <engine:Label text="Label" name="NameLabel" />
        </engine:VisualElement>
        <engine:VisualElement name="Right" style="flex-grow: 1; height: 100%; flex-shrink: 0;">
            <engine:Label name="TextLabel" style="font-size: 54px; -unity-font-definition: url(&quot;project://database/Assets/05.Font/Maplestory%20Light.ttf?fileID=12800000&amp;guid=b7853b5ad26567e41a3c4210e64c5419&amp;type=3#Maplestory Light&quot;); white-space: pre-wrap; flex-grow: 1; padding-top: 35px;" />
        </engine:VisualElement>
    </engine:VisualElement>
    <engine:VisualElement name="FadePanel" style="flex-grow: 1; background-color: rgb(0, 0, 0); display: none; height: 100%; position: absolute; width: 100%;" />
</engine:UXML>
