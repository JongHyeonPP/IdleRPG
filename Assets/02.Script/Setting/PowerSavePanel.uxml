<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="PowerSavePanel" style="flex-grow: 1; background-color: rgb(0, 0, 0); -unity-font-definition: url(&quot;project://database/Assets/Store/font/Galmuri11_MainFont.ttf?fileID=12800000&amp;guid=db08679a010d4084c84f83c57830d6d4&amp;type=3#Galmuri11_MainFont&quot;); font-size: 166px; color: rgb(255, 255, 255); padding-top: 300px; align-items: center;">
        <ui:Label text="1:25 PM" name="TimeLabel" style="-unity-text-align: upper-center; margin-bottom: 58px; color: rgb(238, 238, 238); -unity-font-style: bold;" />
        <ui:Label text="시작의 평원Ⅰ" name="StageNumLabel" style="-unity-text-align: upper-center; font-size: 69px; margin-bottom: 17px; color: rgb(185, 185, 185);" />
        <ui:Label text="Stage 1" name="StageNameLabel" style="-unity-text-align: upper-center; font-size: 112px; color: rgb(185, 185, 185);" />
        <ui:VisualElement style="flex-grow: 0; height: 582px; width: 785px; background-image: url(&quot;project://database/Assets/07.Texture/Setting/Battery.png?fileID=2800000&amp;guid=6c46bf25a7c27724b9dec3fe202ce39a&amp;type=3#Battery&quot;); align-items: center; justify-content: center; -unity-background-image-tint-color: rgb(224, 224, 224); left: 32px; font-size: 144px;">
            <ui:Label text="10%" style="left: -27px; color: rgb(224, 224, 224);" />
        </ui:VisualElement>
        <ui:Label text="충전 중..." name="StageNameLabel" style="-unity-text-align: upper-center; font-size: 112px; color: rgb(185, 185, 185); top: -38px; margin-bottom: 124px;" />
        <ui:Button name="ReinforceButton" focusable="false" style="position: relative; width: 600px; height: 300px; display: flex; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; -unity-background-image-tint-color: rgb(164, 164, 164); background-image: url(&quot;project://database/Assets/Asset/Honeti/PixelArtGUI3/Textures/Panels/UniversalPanel4.png?fileID=21300000&amp;guid=afd0d6697682a8f4096f448c83ac52f3&amp;type=3#UniversalPanel4&quot;); color: rgb(255, 255, 255); align-items: center; font-size: 70px; justify-content: flex-start; flex-direction: row; left: auto; background-color: rgba(188, 188, 188, 0);">
            <ui:VisualElement name="Detail" style="flex-grow: 1; position: absolute; width: 100%; height: 100%; display: flex;">
                <ui:VisualElement picking-mode="Ignore" name="DetailTop" style="flex-grow: 1; position: absolute; width: 100%; height: 100%; background-image: url(&quot;project://database/Assets/Asset/Honeti/PixelArtGUI3/Textures/Panels/UniversalPanel4TBevel.png?fileID=21300000&amp;guid=b3be0bdb85a86cc489b2d4772915967d&amp;type=3#UniversalPanel4TBevel&quot;); -unity-background-image-tint-color: rgb(202, 202, 202);" />
                <ui:VisualElement picking-mode="Ignore" name="DetailBottom" style="flex-grow: 1; position: absolute; width: 100%; height: 100%; background-image: url(&quot;project://database/Assets/Asset/Honeti/PixelArtGUI3/Textures/Panels/UniversalPanel4BBevel.png?fileID=21300000&amp;guid=465de44ed4062d24da21ac82818bc18e&amp;type=3#UniversalPanel4BBevel&quot;); -unity-background-image-tint-color: rgb(128, 128, 128);" />
            </ui:VisualElement>
            <ui:VisualElement name="FillSize" style="flex-grow: 0; width: 31%; height: 100%; align-self: flex-start; overflow: hidden;">
                <ui:VisualElement name="Fill" style="flex-grow: 1; width: 600px; height: 300px; background-color: rgb(0, 0, 0); background-image: url(&quot;project://database/Assets/Asset/Honeti/PixelArtGUI3/Textures/Panels/UniversalPanel4.png?fileID=21300000&amp;guid=afd0d6697682a8f4096f448c83ac52f3&amp;type=3#UniversalPanel4&quot;); -unity-background-image-tint-color: rgb(176, 102, 37);">
                    <ui:VisualElement name="Detail" style="flex-grow: 1; position: absolute; width: 100%; height: 100%; display: flex;">
                        <ui:VisualElement picking-mode="Ignore" name="DetailTop" style="flex-grow: 1; position: absolute; width: 100%; height: 100%; background-image: url(&quot;project://database/Assets/Asset/Honeti/PixelArtGUI3/Textures/Panels/UniversalPanel4TBevel.png?fileID=21300000&amp;guid=b3be0bdb85a86cc489b2d4772915967d&amp;type=3#UniversalPanel4TBevel&quot;); -unity-background-image-tint-color: rgb(214, 128, 52);" />
                        <ui:VisualElement picking-mode="Ignore" name="DetailBottom" style="flex-grow: 1; position: absolute; width: 100%; height: 100%; background-image: url(&quot;project://database/Assets/Asset/Honeti/PixelArtGUI3/Textures/Panels/UniversalPanel4BBevel.png?fileID=21300000&amp;guid=465de44ed4062d24da21ac82818bc18e&amp;type=3#UniversalPanel4BBevel&quot;); -unity-background-image-tint-color: rgb(128, 71, 22);" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label text="꾹 눌러서&#10;절전 모드 해제" style="position: absolute; width: 100%; height: 100%; -unity-text-outline-width: 4px; -unity-font-style: bold;" />
        </ui:Button>
    </ui:VisualElement>
</ui:UXML>
